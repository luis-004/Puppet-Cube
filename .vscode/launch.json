    "version": "0.2.0",
    "configurations": [
      {
        "name": "(gdb) Launch",
        "type": "cppdbg",
        "request": "launch",
        "program": "${fileDirname}/${fileBasenameNoExtension}.exe",
        "args": [],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "environment": [],
        "externalConsole": true,  // Use an external terminal for input/output
        "MIMode": "gdb",
        "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe",  // Path to your gdb.exe
        "setupCommands": [
          {
            "description": "Enable pretty-printing for gdb",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
          }
        ],
        "preLaunchTask": "C/C++: g++.exe build active file",
        "miDebuggerArgs": "",
        "logging": {
          "moduleLoad": false,
          "trace": false,
          "engineLogging": false
        },
        "visualizerFile": "${workspaceFolder}/.vscode/visualizer.natvis",
        "launchCompleteCommand": "exec-run",
        "serverStarted": "",
        "filterStderr": true,
        "filterStdout": true
      },
      {
        "name": "Main Launch",
        "type": "cppdbg",
        "request": "launch",
        "program": "${fileDirname}/${fileBasenameNoExtension}.exe",
        "args": [],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "environment": [],
        "externalConsole": true,  // Use an external terminal for input/output
        "MIMode": "gdb",
        "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe",  // Path to your gdb.exe
        "setupCommands": [
          {
            "description": "Enable pretty-printing for gdb",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
          }
        ],
        "preLaunchTask": "Build Main",
        "miDebuggerArgs": "",
        "logging": {
          "moduleLoad": false,
          "trace": false,
          "engineLogging": false
        },
        "visualizerFile": "${workspaceFolder}/.vscode/visualizer.natvis",
        "launchCompleteCommand": "exec-run",
        "serverStarted": "",
        "filterStderr": true,
        "filterStdout": true
      },
      {
        "name": "RSS Launch",
        "type": "cppdbg",
        "request": "launch",
        "program": "${fileDirname}/${fileBasenameNoExtension}.exe",
        "args": [],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "environment": [],
        "externalConsole": true,  // Use an external terminal for input/output
        "MIMode": "gdb",
        "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe",  // Path to your gdb.exe
        "setupCommands": [
          {
            "description": "Enable pretty-printing for gdb",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
          }
        ],
        "preLaunchTask": "Build RSS",
        "miDebuggerArgs": "",
        "logging": {
          "moduleLoad": false,
          "trace": false,
          "engineLogging": false
        },
        "visualizerFile": "${workspaceFolder}/.vscode/visualizer.natvis",
        "launchCompleteCommand": "exec-run",
        "serverStarted": "",
        "filterStderr": true,
        "filterStdout": true
      }
    ]
}
